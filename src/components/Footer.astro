---
const currentYear = new Date().getFullYear();
---

<footer class="global-footer">
  <div class="footer-container container">
    <div class="footer-row top-row">
      <div class="contact-statement font-utility text-muted">
        Open to consulting, collaboration and good problems.
      </div>
      <a href="mailto:hello@mups.co.zw" class="email-link">
        hello@mups.co.zw ↗
      </a>
    </div>

    <div class="footer-row middle-row hairline-divider">
      <nav class="footer-nav">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/work">Work</a></li>
          <li><a href="/blog">Writing</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>
      <nav class="footer-social">
        <ul>
          <li><a href="https://github.com/iammerus" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="https://x.com/wezhirawevhu" target="_blank" rel="noopener noreferrer">X</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-row bottom-row hairline-divider">
      <div class="copyright font-utility text-muted">
        © {currentYear} Melvin Mupondori
      </div>
      <div class="theme-control font-utility">
        bench light: 
        <button id="theme-toggle-footer-on" class="theme-btn">on</button> / 
        <button id="theme-toggle-footer-off" class="theme-btn">off</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .global-footer {
    padding: 4rem 0 2rem;
    view-transition-name: footer;
  }
  
  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  
  .top-row {
    align-items: flex-start;
  }
  
  .email-link {
    font-size: 1.125rem;
  }
  
  .footer-nav ul, .footer-social ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }
  
  .footer-nav a, .footer-social a {
    color: var(--text-color);
  }
  
  .footer-nav a:hover, .footer-social a:hover {
    color: var(--accent-color);
  }
  
  .theme-btn {
    background: none;
    border: none;
    padding: 0;
    color: var(--text-muted);
    font-family: var(--font-utility);
    cursor: pointer;
  }
  
  .theme-btn:hover {
    color: var(--text-color);
  }
  
  .theme-btn.active {
    color: var(--accent-color);
  }
  
  @media (max-width: 768px) {
    .footer-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    
    .footer-nav ul, .footer-social ul {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>

<script>
  function updateThemeButtons() {
    const isDark = document.documentElement.hasAttribute('data-theme');
    const onBtn = document.getElementById('theme-toggle-footer-on');
    const offBtn = document.getElementById('theme-toggle-footer-off');
    
    if (onBtn && offBtn) {
      if (isDark) {
        offBtn.classList.add('active');
        onBtn.classList.remove('active');
      } else {
        onBtn.classList.add('active');
        offBtn.classList.remove('active');
      }
    }
  }

  function setupFooterTheme() {
    updateThemeButtons();
    
    const onBtn = document.getElementById('theme-toggle-footer-on');
    const offBtn = document.getElementById('theme-toggle-footer-off');
    
    if (onBtn) {
      onBtn.addEventListener('click', () => {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
        updateThemeButtons();
      });
    }
    
    if (offBtn) {
      offBtn.addEventListener('click', () => {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
        updateThemeButtons();
      });
    }
    
    // Listen for mutations on html to update active states when header toggle is used
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'data-theme') {
          updateThemeButtons();
        }
      });
    });
    
    observer.observe(document.documentElement, { attributes: true });
  }

  document.addEventListener('astro:page-load', setupFooterTheme);
</script>
