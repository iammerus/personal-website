---
interface Props {
  /** Homepage only: the spine terminates here at a gnd symbol */
  grounded?: boolean;
}

const { grounded = false } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class:list={['global-footer', { grounded }]}>
  <div class="footer-container container">
    {grounded && (
      <div class="gnd-marker" aria-hidden="true">
        <div class="gnd-segment"></div>
        <svg class="gnd-symbol" width="18" height="14" viewBox="0 0 18 14" fill="none" stroke="var(--text-muted)" stroke-width="1.5">
          <line x1="1" y1="1" x2="17" y2="1" />
          <line x1="4.5" y1="6" x2="13.5" y2="6" />
          <line x1="7.5" y1="11" x2="10.5" y2="11" />
        </svg>
        <span class="gnd-label font-utility text-muted">gnd</span>
      </div>
    )}
    <div class="footer-row top-row">
      <div class="contact-statement font-utility text-muted">
        Open to consulting, collaboration and good problems.
      </div>
      <a href="mailto:hello@mups.co.zw" class="email-link">
        hello@mups.co.zw ↗
      </a>
    </div>

    <div class="footer-row middle-row hairline-divider">
      <nav class="footer-nav">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/work">Work</a></li>
          <li><a href="/blog">Writing</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>
      <nav class="footer-social">
        <ul>
          <li><a href="https://github.com/iammerus" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="https://x.com/wezhirawevhu" target="_blank" rel="noopener noreferrer">X</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-row bottom-row hairline-divider">
      <div class="copyright font-utility text-muted">
        © {currentYear} Melvin Mupondori
      </div>
      <div class="theme-control font-utility">
        bench light: 
        <button id="theme-toggle-footer-on" class="theme-btn">on</button> / 
        <button id="theme-toggle-footer-off" class="theme-btn">off</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .global-footer {
    padding: 4rem 0 2rem;
    view-transition-name: footer;
  }

  /* Grounded variant (homepage): the spine's rail enters from above and
     terminates at a ground symbol beside the contact row */
  .global-footer.grounded .footer-container {
    position: relative;
    padding-left: 3rem;
  }

  .gnd-marker {
    position: absolute;
    left: 2rem;
    top: 0;
  }

  /* Bridges main's 4rem bottom padding (where the home rail's bleed ends)
     down past the footer's top padding to the symbol */
  .gnd-segment {
    position: absolute;
    left: 0;
    top: -4rem;
    width: 1px;
    height: 5.5rem;
    background-color: var(--border-color);
  }

  .gnd-symbol {
    position: absolute;
    left: 0;
    top: 1.5rem;
    transform: translateX(-50%);
  }

  .gnd-label {
    position: absolute;
    left: 0;
    top: calc(1.5rem + 18px);
    transform: translateX(-50%);
    font-size: 0.625rem;
  }

  @media (max-width: 768px) {
    /* mobile main padding-bottom is 2.5rem */
    .gnd-segment {
      top: -2.5rem;
      height: 4rem;
    }
  }

  @media (max-width: 600px) {
    .global-footer.grounded .footer-container {
      padding-left: 2rem;
    }

    .gnd-marker {
      left: 1rem;
    }
  }
  
  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  
  .top-row {
    align-items: flex-start;
  }
  
  .email-link {
    font-size: 1.125rem;
  }
  
  .footer-nav ul, .footer-social ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }
  
  .footer-nav a, .footer-social a {
    color: var(--text-color);
  }
  
  .footer-nav a:hover, .footer-social a:hover {
    color: var(--accent-color);
  }
  
  .theme-btn {
    background: none;
    border: none;
    padding: 0;
    color: var(--text-muted);
    font-family: var(--font-utility);
    cursor: pointer;
  }
  
  .theme-btn:hover {
    color: var(--text-color);
  }
  
  .theme-btn.active {
    color: var(--accent-color);
  }
  
  @media (max-width: 768px) {
    .footer-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    
    .footer-nav ul, .footer-social ul {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>

<script>
  import { track } from '../lib/analytics';

  function updateThemeButtons() {
    const isDark = document.documentElement.hasAttribute('data-theme');
    const onBtn = document.getElementById('theme-toggle-footer-on');
    const offBtn = document.getElementById('theme-toggle-footer-off');
    
    if (onBtn && offBtn) {
      if (isDark) {
        offBtn.classList.add('active');
        onBtn.classList.remove('active');
      } else {
        onBtn.classList.add('active');
        offBtn.classList.remove('active');
      }
    }
  }

  function setupFooterTheme() {
    updateThemeButtons();
    
    const onBtn = document.getElementById('theme-toggle-footer-on');
    const offBtn = document.getElementById('theme-toggle-footer-off');
    
    if (onBtn) {
      onBtn.addEventListener('click', () => {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
        updateThemeButtons();
        track('theme_changed');
      });
    }
    
    if (offBtn) {
      offBtn.addEventListener('click', () => {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
        updateThemeButtons();
        track('theme_changed');
      });
    }
    
    // Listen for mutations on html to update active states when header toggle is used
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'data-theme') {
          updateThemeButtons();
        }
      });
    });
    
    observer.observe(document.documentElement, { attributes: true });
  }

  document.addEventListener('astro:page-load', setupFooterTheme);
</script>
