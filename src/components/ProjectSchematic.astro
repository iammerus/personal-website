---
// ZenHost deploy-route schematic — the case-study visual until a real interface
// crop exists. Drawn in the site's trace language: hairline routes, square
// nodes, one quiet accent. ponytail: no props until a second project needs them.
---

<div class="schematic" role="img" aria-label="ZenHost deployment route: git push to build to proxy, routed to two tenant apps and a database">
  <svg viewBox="-14 0 476 240" fill="none" preserveAspectRatio="xMidYMid meet">
    <!-- primary route: git push → build → proxy -->
    <g class="route-primary">
      <line x1="28" y1="120" x2="90" y2="120" />
      <line x1="162" y1="120" x2="224" y2="120" />
    </g>

    <!-- branches: proxy → tenants → db -->
    <g class="route-secondary">
      <path d="M 296 120 H 320 V 72 H 344" />
      <path d="M 296 120 H 320 V 168 H 344" />
      <path d="M 416 72 H 428 V 120 H 432" />
      <path d="M 416 168 H 428 V 120" />
    </g>

    <!-- nodes -->
    <circle class="node-start" cx="24" cy="120" r="4" />
    <g class="node-boxes">
      <rect x="90" y="96" width="72" height="48" />
      <rect x="224" y="96" width="72" height="48" />
      <rect x="344" y="48" width="72" height="48" />
      <rect x="344" y="144" width="72" height="48" />
    </g>
    <circle class="node-db" cx="440" cy="120" r="7" />

    <!-- labels -->
    <g class="labels">
      <text x="24" y="142" text-anchor="middle">git push</text>
      <text x="126" y="124" text-anchor="middle">build</text>
      <text x="260" y="124" text-anchor="middle">proxy</text>
      <text x="380" y="76" text-anchor="middle">app a</text>
      <text x="380" y="172" text-anchor="middle">app b</text>
      <text x="440" y="104" text-anchor="middle">db</text>
    </g>
  </svg>
</div>

<style>
  .schematic {
    width: 100%;
    height: 100%;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background-color: var(--c-bone);
    border: 1px solid var(--border-color);
  }

  svg {
    width: 100%;
    max-width: 460px;
    height: auto;
  }

  .route-primary line,
  .route-secondary path {
    stroke: var(--border-color);
    stroke-width: 1.5;
    transition: stroke 200ms ease;
  }

  .node-boxes rect {
    stroke: var(--border-color);
    stroke-width: 1.5;
    fill: var(--bg-color);
  }

  .node-start {
    fill: var(--accent-color);
  }

  .node-db {
    stroke: var(--border-color);
    stroke-width: 1.5;
    fill: none;
    transition: stroke 200ms ease;
  }

  .labels text {
    fill: var(--text-muted);
    font-family: var(--font-utility);
    font-size: 11px;
  }

  /* The route gains colour when the surrounding entry is hovered or focused */
  :global(.project-entry:hover) .route-primary line,
  :global(.project-entry:focus-within) .route-primary line {
    stroke: var(--accent-color);
  }

  :global(.project-entry:hover) .node-db,
  :global(.project-entry:focus-within) .node-db {
    stroke: var(--accent-color);
  }
</style>
