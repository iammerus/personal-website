---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Signal Lost · Melvin Mupondori"
  description="The requested route could not be found."
>
  <div class="container not-found-container">
    
    <div class="broken-route-visual">
      <div class="route-line-left"></div>
      <div class="broken-gap">
        <span class="cross">×</span>
      </div>
      <div class="route-line-right"></div>
    </div>

    <div class="not-found-content">
      <h1 class="font-display">Signal lost.</h1>
      
      <p class="error-message">
        The route exists.<br/>
        This endpoint does not.
      </p>
      
      <a href="/" class="return-link font-utility">
        Return to the main route
        <span class="connect-node"></span>
      </a>
    </div>

  </div>
</BaseLayout>

<style>
  .not-found-container {
    padding-top: 6rem;
    padding-bottom: 8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .broken-route-visual {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 400px;
    margin: 0 auto 4rem;
    position: relative;
  }

  .route-line-left,
  .route-line-right {
    height: 1px;
    background-color: var(--border-color);
    flex-grow: 1;
  }

  .broken-gap {
    padding: 0 2rem;
    color: var(--text-muted);
    font-size: 1.5rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-content h1 {
    font-size: 3rem;
    margin-bottom: 2rem;
  }

  .error-message {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: 3rem;
    color: var(--text-color);
  }

  .return-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 1rem 2rem;
    border: 1px solid var(--border-color);
    position: relative;
    transition: color 200ms ease, border-color 200ms ease;
  }

  .connect-node {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: transparent;
    border: 1px solid var(--border-color);
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .return-link:hover,
  .return-link:focus {
    color: var(--accent-color);
    border-color: var(--accent-color);
  }

  .return-link:hover .connect-node,
  .return-link:focus .connect-node {
    background-color: var(--accent-color);
    border-color: var(--accent-color);
  }

  /* Simulate route connecting on hover */
  .return-link::before {
    content: '';
    position: absolute;
    top: -2rem; /* Move up to intersect the broken visual */
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 0;
    background-color: var(--accent-color);
    transition: height 300ms ease;
    z-index: -1;
  }

  .return-link:hover::before,
  .return-link:focus::before {
    height: 2rem;
  }

</style>
