---
import BaseLayout from '../layouts/BaseLayout.astro';
import { person } from '../lib/schema';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: person,
};
---

<BaseLayout
  title="About · Melvin Mupondori"
  description="About Melvin Mupondori, a senior software engineer working across developer platforms, products and the occasional undocumented hardware signal."
  structuredData={structuredData}
>
  <div class="container about-container reading-container">
    
    <header class="about-header">
      <h1 class="font-display">About</h1>
    </header>

    <div class="about-content">
      
      <section class="about-opening">
        <p>
          I started my career fighting terrible documentation. 
        </p>
        <p>
          When I was working on integration projects around 2018, I found that connecting to local payment gateways was a deeply frustrating experience. The documentation was difficult to read, integration was harder than it needed to be, and developers were often treated as an afterthought rather than the primary users of the service.
        </p>
        <p>
          I proposed a different approach: treat developers as users, build proper SDKs, and write documentation that actually helps someone get a working implementation running by the afternoon. I ended up building those tools and a community around the Paynow service. We watched integration numbers move from roughly 100 a month to more than 2,000. 
        </p>
        <p>
          That experience shaped how I work. I build software, tinker with hardware, and spend an unreasonable amount of time figuring out how things work, so that the person using the system doesn't have to.
        </p>
      </section>

      <section class="career-chapters hairline-divider">
        <h2>Career</h2>
        
        <div class="chapter">
          <div class="chapter-meta">
            <h3 class="font-display">Kubermatic</h3>
            <div class="font-utility text-muted">Senior Software Engineer</div>
            <div class="font-utility text-muted">Feb 2026 to present</div>
          </div>
          <div class="chapter-details">
            <p>
              I work on KDP, focusing on Kubernetes, platform work, and product engineering. This role marks a deliberate move into deeper infrastructure work, building the developer-platform tooling that abstracts away the complexity of cluster management.
            </p>
          </div>
        </div>
        
        <div class="chapter">
          <div class="chapter-meta">
            <h3 class="font-display">Softrite</h3>
            <div class="font-utility text-muted">Project Lead</div>
            <div class="font-utility text-muted">Jun 2025 to Feb 2026</div>
          </div>
          <div class="chapter-details">
            <p>
              A focused period of ownership and delivery. I was responsible for product decisions and leading work across a broader surface, ensuring that technical choices aligned with actual business requirements.
            </p>
          </div>
        </div>
        
        <div class="chapter">
          <div class="chapter-meta">
            <h3 class="font-display">Community Dental Partners</h3>
            <div class="font-utility text-muted">Software Engineer</div>
            <div class="font-utility text-muted">2022 to 2025</div>
          </div>
          <div class="chapter-details">
            <p>
              Built and maintained software inside a real, physical operating business. When your code runs a dental practice, edge cases matter, and reliability is immediately visible to the people in the room.
            </p>
          </div>
        </div>
        
        <div class="chapter">
          <div class="chapter-meta">
            <h3 class="font-display">Paynow / WebDev</h3>
            <div class="font-utility text-muted">Full-stack Software Engineer</div>
            <div class="font-utility text-muted">2018</div>
          </div>
          <div class="chapter-details">
            <p>
              The developer-experience story. I focused on the impact of SDKs, community building, and writing documentation that treated developers as first-class users.
            </p>
          </div>
        </div>
      </section>

      <section class="personal-aside hairline-divider">
        <h2>Elsewhere</h2>
        <p>
          Away from work, I'm usually taking something apart, trying to read a signal that was never documented, watching anime, or finding another reason to buy an ESP32.
        </p>
        
        <ul class="elsewhere-links font-utility">
          <li><span class="link-label">Email:</span> <a href="mailto:hello@mups.co.zw">hello@mups.co.zw</a></li>
          <li><span class="link-label">GitHub:</span> <a href="https://github.com/iammerus" target="_blank" rel="noopener noreferrer">@iammerus</a></li>
          <li><span class="link-label">X:</span> <a href="https://x.com/wezhirawevhu" target="_blank" rel="noopener noreferrer">@wezhirawevhu</a></li>
          <li><span class="link-label">CV:</span> <a href="/resume.pdf" target="_blank">PDF Download</a></li>
        </ul>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .about-container {
    padding-top: 2rem;
    padding-bottom: 6rem;
  }

  .about-header {
    margin-bottom: 4rem;
  }

  .about-header h1 {
    font-size: 2.5rem;
  }

  .about-content section {
    margin-bottom: 4rem;
  }
  
  .about-content h2 {
    font-size: 1.5rem;
    margin-bottom: 2rem;
  }

  .about-opening p {
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  
  .about-opening p:first-child {
    font-size: 1.25rem;
    font-weight: 500;
  }

  .career-chapters {
    padding-top: 4rem;
  }

  .chapter {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .chapter:last-child {
    margin-bottom: 0;
  }

  .chapter-meta h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }
  
  .chapter-meta .font-utility {
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
  }

  .chapter-details p {
    margin: 0;
    line-height: 1.6;
    color: var(--text-color);
  }

  .personal-aside {
    padding-top: 4rem;
  }

  .personal-aside p {
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .elsewhere-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .elsewhere-links li {
    display: flex;
  }

  .link-label {
    width: 80px;
    color: var(--text-muted);
  }

  .elsewhere-links a {
    color: var(--text-color);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--border-color);
  }

  .elsewhere-links a:hover {
    color: var(--accent-color);
    text-decoration-color: var(--accent-color);
  }

  @media (max-width: 768px) {
    .about-container {
      padding-bottom: 3rem;
    }

    .about-header {
      margin-bottom: 2.5rem;
    }

    .about-content section {
      margin-bottom: 3rem;
    }

    .career-chapters,
    .personal-aside {
      padding-top: 2.5rem;
    }

    .chapter {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
