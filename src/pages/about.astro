---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailLink from '../components/EmailLink.astro';
import { person } from '../lib/schema';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: person,
};
---

<BaseLayout
  title="About · Melvin Mupondori"
  description="About Melvin Mupondori, a senior software engineer working across developer platforms, products and the occasional undocumented hardware signal."
  structuredData={structuredData}
>
  <div class="container about-container">
    
    <header class="about-header">
      <h1 class="font-display">About</h1>
    </header>

    <div class="about-content">
      
      <section class="about-opening">
        <p>
          I'm Melvin, a software engineer based in Harare.
        </p>
        <p>
          I currently work at Kubermatic on KDP, building developer-platform tooling around Kubernetes. Outside that role, I'm building ZenHost, a hosting platform where I work through deployment, networking and application-isolation problems from both the engineering and product sides.
        </p>
        <p>
          Before this, I worked across payments, healthcare operations, agency products and infrastructure. I've built SDKs for payment APIs, worked on services handling more than a million requests a day, moved workloads onto Kubernetes, and rewritten frontends that had become difficult to change. I like being close to both the system and the people using it. It makes it harder to confuse shipping code with solving the problem.
        </p>
      </section>

      <section class="career-chapters hairline-divider">
        <h2>Career</h2>
        
        <div class="chapter">
          <div class="chapter-meta">
            <h3 class="font-display">Kubermatic</h3>
            <div class="font-utility text-muted">Senior Software Engineer</div>
            <div class="font-utility text-muted">Feb 2026 to present</div>
          </div>
          <div class="chapter-details">
            <p>
              I work on KDP, building developer-platform tooling around Kubernetes and the systems teams use to manage their platforms.
            </p>
          </div>
        </div>
        
        <div class="chapter">
          <div class="chapter-meta">
            <h3 class="font-display">Softrite</h3>
            <div class="font-utility text-muted">Project Lead</div>
            <div class="font-utility text-muted">Jun 2025 to Feb 2026</div>
          </div>
          <div class="chapter-details">
            <p>
              I led project delivery across product and engineering work, making technical decisions while staying close to what the business actually needed shipped.
            </p>
          </div>
        </div>
        
        <div class="chapter">
          <div class="chapter-meta">
            <h3 class="font-display">Community Dental Partners</h3>
            <div class="font-utility text-muted">Software Engineer</div>
            <div class="font-utility text-muted">2022 to 2025</div>
          </div>
          <div class="chapter-details">
            <p>
              I worked on services used across a large dental group, including a web service handling more than one million requests a day. I helped split a monolithic API into smaller services, moved workloads to AWS EKS, and automated deployments that had previously taken minutes.
            </p>
          </div>
        </div>

        <div class="chapter">
          <div class="chapter-meta">
            <h3 class="font-display">Consulting</h3>
            <div class="font-utility text-muted">Software Engineer</div>
            <div class="font-utility text-muted">2019 to 2022</div>
          </div>
          <div class="chapter-details">
            <p>
              I worked with teams including Gfinity, OperateBeyond and American Sign Language Communication. The work ranged from rebuilding an esports platform in Vue and Nuxt, to maintaining NVIDIA's GeForce forums, improving Elasticsearch indexing and search, and shortening build and deployment times.
            </p>
          </div>
        </div>
        
        <div class="chapter">
          <div class="chapter-meta">
            <h3 class="font-display">Paynow / WebDev</h3>
            <div class="font-utility text-muted">Full-stack Software Engineer</div>
            <div class="font-utility text-muted">2018</div>
          </div>
          <div class="chapter-details">
            <p>
              I built SDKs and rewrote documentation for Paynow's payment API, making local integrations easier to get running. I also moved frontend work from jQuery and vanilla JavaScript to Vue.
            </p>
          </div>
        </div>
      </section>

      <section class="personal-aside hairline-divider">
        <h2>Elsewhere</h2>
        <p>
          Away from work, I'm usually watching anime or taking something apart to find out how it works. Lately, that has meant an abandoned BMW and our off-grid solar setup.
        </p>
        
        <ul class="elsewhere-links font-utility">
          <li><span class="link-label">Email:</span> <EmailLink /></li>
          <li><span class="link-label">GitHub:</span> <a href="https://github.com/iammerus" target="_blank" rel="noopener noreferrer">@iammerus</a></li>
          <li><span class="link-label">X:</span> <a href="https://x.com/wezhirawevhu" target="_blank" rel="noopener noreferrer">@wezhirawevhu</a></li>
          <li><span class="link-label">CV:</span> <a href="/resume.pdf" target="_blank">PDF Download</a></li>
        </ul>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .about-container {
    padding-top: 2rem;
    padding-bottom: 6rem;
  }

  /* Left-anchored reading measure — same left rail as every other page */
  .about-header,
  .about-content {
    max-width: var(--reading-width);
  }

  .about-header {
    margin-bottom: 4rem;
  }

  .about-header h1 {
    font-size: 2.5rem;
  }

  .about-content section {
    margin-bottom: 4rem;
  }
  
  .about-content h2 {
    font-size: 1.5rem;
    margin-bottom: 2rem;
  }

  .about-opening p {
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  
  .about-opening p:first-child {
    font-size: 1.25rem;
    font-weight: 500;
  }

  .career-chapters {
    padding-top: 4rem;
  }

  .chapter {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .chapter:last-child {
    margin-bottom: 0;
  }

  .chapter-meta h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }
  
  .chapter-meta .font-utility {
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
  }

  .chapter-details p {
    margin: 0;
    line-height: 1.6;
    color: var(--text-color);
  }

  .personal-aside {
    padding-top: 4rem;
  }

  .personal-aside p {
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .elsewhere-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .elsewhere-links li {
    display: flex;
  }

  .link-label {
    width: 80px;
    color: var(--text-muted);
  }

  .elsewhere-links a {
    color: var(--text-color);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--border-color);
  }

  .elsewhere-links a:hover {
    color: var(--accent-color);
    text-decoration-color: var(--accent-color);
  }

  @media (max-width: 768px) {
    .about-container {
      padding-bottom: 3rem;
    }

    .about-header {
      margin-bottom: 2.5rem;
    }

    .about-content section {
      margin-bottom: 3rem;
    }

    .career-chapters,
    .personal-aside {
      padding-top: 2.5rem;
    }

    .chapter {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
