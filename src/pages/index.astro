---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectSchematic from '../components/ProjectSchematic.astro';
import { getCollection } from 'astro:content';
import { person, SITE_URL } from '../lib/schema';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort by date descending
const recentPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [person, { '@type': 'WebSite', name: 'Melvin Mupondori', url: SITE_URL }],
};
---

<BaseLayout
  title="Melvin Mupondori · Software Engineer"
  description="Melvin Mupondori is a software engineer in Harare who builds developer platforms, hosting tools and hardware experiments, then writes about how they work."
  structuredData={structuredData}
>
  <div class="container home-container">
    <div class="trace-line main-route"></div>

    <!-- Section 1: Introduction -->
    <section class="intro-section">
      <h1 class="thesis-line">
        I build software, tinker with hardware, and spend an unreasonable amount of time figuring out how things work.
      </h1>
      <p class="intro-contact font-utility">
        <a href="mailto:hello@mups.co.zw">hello@mups.co.zw</a>
        <span class="contact-sep text-muted">·</span>
        <a href="https://github.com/iammerus" target="_blank" rel="noopener noreferrer">github.com/iammerus</a>
      </p>
      <div class="trace-node route-junction"></div>
    </section>

    <!-- Section 2: Now -->
    <section class="now-section">
      <div class="now-grid">
        <div class="now-main">
          <h2 class="font-utility text-muted section-label">Currently</h2>
          <p>
            At Kubermatic, I work on KDP, building developer-platform tooling around Kubernetes. Outside work, I'm building ZenHost and learning everything that comes with turning hosting into a product.
          </p>
        </div>
        <div class="now-side">
          <h2 class="font-utility text-muted section-label">Also tinkering with</h2>
          <p>
            Listening to a BMW E87's CAN bus with an ESP32 and MCP2551, and pulling RS485 data from my solar inverter into Home Assistant.
          </p>
          <!-- The actual signal chain the paragraph describes -->
          <svg
            class="signal-chain"
            viewBox="0 0 360 96"
            fill="none"
            role="img"
            aria-label="Signal chain: BMW E87 CAN bus through an MCP2551 transceiver to an ESP32, then on to Home Assistant"
          >
            <g class="chain-routes">
              <line x1="50" y1="48" x2="78" y2="48" />
              <line x1="156" y1="48" x2="184" y2="48" />
              <line x1="242" y1="48" x2="282" y2="48" stroke-dasharray="4 4" />
            </g>
            <g class="chain-boxes">
              <rect x="2" y="30" width="48" height="36" />
              <rect x="78" y="30" width="78" height="36" />
              <rect x="184" y="30" width="58" height="36" />
            </g>
            <circle class="chain-end" cx="288" cy="48" r="5" />
            <g class="chain-labels">
              <text x="26" y="52" text-anchor="middle">e87</text>
              <text x="117" y="52" text-anchor="middle">mcp2551</text>
              <text x="213" y="52" text-anchor="middle">esp32</text>
              <text x="64" y="24" text-anchor="middle" class="tiny-label">can</text>
              <text x="288" y="76" text-anchor="middle">home assistant</text>
            </g>
          </svg>
        </div>
      </div>
      <div class="trace-node route-junction"></div>
    </section>

    <!-- Section 3: Something I'm proud of -->
    <section class="proud-section">
      <h2 class="font-utility text-muted section-label">Something I'm proud of</h2>
      <a href="/work/zenhost" class="project-entry">
        <div class="project-info">
          <h3 class="project-name font-display">ZenHost</h3>
          <p class="project-premise">
            A hosting platform I started because deploying and managing ordinary applications still involves too many unrelated tools and too much hidden knowledge.
          </p>
          <div class="project-meta font-utility text-muted">
            <span>Founder and engineer</span>
            <span class="meta-separator">·</span>
            <span class="project-status">Building</span>
          </div>
          <span class="case-link font-utility">Read the case study <span class="case-arrow">→</span></span>
        </div>
        <div class="project-visual">
          <ProjectSchematic />
        </div>
      </a>
      <div class="trace-node route-junction"></div>
    </section>

    <!-- Section 4: Recent writing -->
    <section class="writing-section">
      <h2 class="font-utility text-muted section-label">Recent writing</h2>
      <div class="article-list">
        {recentPosts.length > 0 ? recentPosts.map((post, index) => (
          <a href={`/blog/${post.id}`} class="article-row">
            <div class="article-num font-utility text-muted">B-{(recentPosts.length - index).toString().padStart(3, '0')}</div>
            <div class="article-title">{post.data.title}</div>
            <div class="article-date font-utility text-muted">
              {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
            </div>
            <div class="article-topic font-utility text-muted">
              {post.data.tags.length > 0 ? post.data.tags[0] : 'notes'}
            </div>
          </a>
        )) : (
          <div class="font-utility text-muted py-4">Logs are currently empty.</div>
        )}
      </div>
      <div class="trace-node route-junction end-junction"></div>
    </section>

  </div>
</BaseLayout>

<style>
  .home-container {
    position: relative;
    padding-left: 3rem; /* Space for the route line */
  }

  /* Look comes from the global .trace-line / .trace-node primitives; only position here */
  .main-route {
    left: 2rem;
  }

  .route-junction {
    left: -1rem; /* -3rem from container + 2rem line pos = -1rem relative */
  }
  
  .intro-section .route-junction { top: 2rem; }
  .now-section .route-junction { top: 3rem; }
  .proud-section .route-junction { top: 3rem; }
  .writing-section .route-junction { top: 3rem; }
  
  .end-junction {
    bottom: -4rem;
    top: auto !important;
  }

  section {
    position: relative;
    padding: 3rem 0;
  }

  .intro-section {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .thesis-line {
    font-size: 1.5rem;
    line-height: 1.5;
    max-width: 680px;
    font-weight: 700;
  }

  .intro-contact {
    margin-top: 1.5rem;
    margin-bottom: 0;
    font-size: 0.875rem;
  }

  .contact-sep {
    margin: 0 0.75rem;
  }

  .section-label {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }

  .now-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 4rem;
    max-width: 900px;
  }

  .signal-chain {
    margin-top: 1.5rem;
    width: 100%;
    max-width: 360px;
    height: auto;
  }

  .signal-chain .chain-routes line {
    stroke: var(--border-color);
    stroke-width: 1.5;
  }

  .signal-chain .chain-boxes rect {
    stroke: var(--border-color);
    stroke-width: 1.5;
    fill: var(--c-bone);
  }

  .signal-chain .chain-end {
    fill: var(--accent-color);
  }

  .signal-chain .chain-labels text {
    fill: var(--text-muted);
    font-family: var(--font-utility);
    font-size: 11px;
  }

  .signal-chain .tiny-label {
    font-size: 9px;
  }

  .project-entry {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    color: inherit;
    padding: 2rem;
    border: 1px solid var(--border-color);
    transition: border-color 200ms ease;
  }

  .project-entry:hover {
    text-decoration: none;
    border-color: var(--accent-color);
  }

  .project-name {
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .project-premise {
    margin-bottom: 2rem;
    color: var(--text-color);
  }

  .project-meta {
    font-size: 0.875rem;
  }

  .project-status {
    color: var(--accent-color);
  }

  .meta-separator {
    margin: 0 0.5rem;
  }

  .case-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--accent-color);
  }

  .case-arrow {
    display: inline-block;
    transition: transform 200ms ease;
  }

  .project-entry:hover .case-arrow,
  .project-entry:focus-within .case-arrow {
    transform: translateX(4px);
  }

  .article-list {
    display: flex;
    flex-direction: column;
  }

  .article-row {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-color);
    color: inherit;
    align-items: center;
  }

  .article-row:hover {
    text-decoration: none;
    color: var(--accent-color);
  }

  .article-row:hover .article-num,
  .article-row:hover .article-date,
  .article-row:hover .article-topic {
    color: var(--accent-color);
  }

  .article-title {
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .now-grid, .project-entry {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .article-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 1.5rem 0;
    }

    .article-num { display: none; }

    .article-topic {
      grid-row: 3;
      grid-column: 1;
    }
  }

  @media (max-width: 768px) {
    section {
      padding: 2rem 0;
    }

    .intro-section {
      padding-top: 1rem;
      padding-bottom: 2.5rem;
    }

    .now-section .route-junction,
    .proud-section .route-junction,
    .writing-section .route-junction {
      top: 2rem;
    }
  }

  @media (max-width: 600px) {
    .home-container {
      padding-left: 2rem;
    }
    .main-route {
      left: 1rem;
    }
    .route-junction {
      left: -1rem;
    }
  }
</style>
