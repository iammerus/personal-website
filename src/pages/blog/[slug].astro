---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getArticleNumber, sortArticlesNewestFirst } from '../../lib/articles';
import { person, breadcrumbs, SITE_URL } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });
  
  // Sort posts by date for finding related articles
  const sortedPosts = sortArticlesNewestFirst(posts);
  
  return sortedPosts.map((post, index) => {
    const articleNumber = getArticleNumber(posts, post.id);
    
    // Prev/next within the same series when the post has one; otherwise date neighbours
    let prev = index > 0 ? sortedPosts[index - 1] : null;
    let next = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;
    if (post.data.series) {
      const seriesPosts = sortedPosts
        .filter((p) => p.data.series === post.data.series)
        .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
      const si = seriesPosts.findIndex((p) => p.id === post.id);
      prev = si > 0 ? seriesPosts[si - 1] : null;
      next = si < seriesPosts.length - 1 ? seriesPosts[si + 1] : null;
    }
    
    return {
      params: { slug: post.id },
      props: { 
        post, 
        articleNumber,
        relatedPosts: [prev, next].filter(Boolean)
      },
    };
  });
}

const { post, articleNumber, relatedPosts } = Astro.props;
const { Content } = await render(post);

function getReadingTime(body: string) {
  const words = body.split(/\s+/).length;
  const minutes = Math.ceil(words / 200);
  return `${minutes} min`;
}

// Prepare OpenGraph metadata
const ogUrl = new URL(`/blog/${post.id}`, Astro.site);
const ogImage = post.data.ogImage ? new URL(post.data.ogImage, Astro.site) : new URL(`/og/${post.id}.png`, Astro.site);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
      ...(post.data.updated && { dateModified: post.data.updated.toISOString() }),
      author: person,
      image: ogImage.toString(),
      mainEntityOfPage: ogUrl.toString(),
    },
    breadcrumbs([
      { name: 'Home', url: SITE_URL },
      { name: 'Writing', url: `${SITE_URL}/blog` },
      { name: post.data.title, url: ogUrl.toString() },
    ]),
  ],
};
---

<BaseLayout
  title={`${post.data.title} · Melvin Mupondori`}
  description={post.data.description}
  image={ogImage.toString()}
  structuredData={structuredData}
  stickyHeader
>
  <article class="article-container container" id="article-content">
    <header class="article-header">
      <div class="header-meta font-utility text-muted">
        <span class="article-num">{articleNumber}</span>
        <span class="read-time">{getReadingTime(post.body || '')} read</span>
      </div>
      
      <h1 class="font-display">{post.data.title}</h1>
      
      <p class="article-description text-muted">
        {post.data.description}
      </p>
      
      <div class="article-details font-utility text-muted">
        <div class="detail-group">
          <span class="detail-label">Published</span>
          <span>{post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
        </div>
        
        {post.data.updated && (
          <div class="detail-group">
            <span class="detail-label">Updated</span>
            <span>{post.data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
          </div>
        )}
        
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="detail-group">
            <span class="detail-label">Tags</span>
            <span>{post.data.tags.join(', ')}</span>
          </div>
        )}
        
        {post.data.relatesTo && (
          <div class="detail-group">
            <span class="detail-label">Related</span>
            <a href={`/work/${post.data.relatesTo}`} class="related-link">
              {post.data.relatesTo === 'zenhost' ? 'ZenHost' : post.data.relatesTo}
            </a>
          </div>
        )}
      </div>
    </header>

    <div class="article-body">
      <Content />
    </div>

    <footer class="article-footer hairline-divider">
      <h3 class="font-display">Related writing</h3>
      <div class="related-grid">
        {relatedPosts.map(related => (
          <a href={`/blog/${related.id}`} class="related-card">
            <div class="related-date font-utility text-muted">
              {related.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
            </div>
            <h4 class="related-title font-display">{related.data.title}</h4>
          </a>
        ))}
        {post.data.relatesTo && (
           <a href={`/work/${post.data.relatesTo}`} class="related-card case-study-card">
             <div class="related-date font-utility text-muted">Case Study</div>
             <h4 class="related-title font-display">
               {post.data.relatesTo === 'zenhost' ? 'ZenHost' : post.data.relatesTo}
             </h4>
           </a>
        )}
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .article-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  /* Left-anchored reading measure — same left rail as every other page.
     The related-writing footer keeps the full grid width. */
  .article-header,
  .article-body {
    max-width: var(--reading-width);
  }

  .article-header {
    margin-bottom: 4rem;
  }

  .header-meta {
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .article-num {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--border-color);
  }

  .read-time {
    font-size: 0.875rem;
  }

  .article-header h1 {
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    max-width: 100%;
  }

  .article-description {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 90%;
  }

  .article-details {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .detail-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .detail-label {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .related-link {
    color: var(--text-color);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--border-color);
  }

  .related-link:hover {
    color: var(--accent-color);
    text-decoration-color: var(--accent-color);
  }

  /* Typography for article body */
  .article-body :global(h2) {
    font-size: 1.75rem;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
  }

  .article-body :global(h3) {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .article-body :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.7;
    font-size: 1.0625rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .article-body :global(blockquote) {
    border-left: 2px solid var(--accent-color);
    margin: 2rem 0;
    padding-left: 1.5rem;
    font-style: italic;
    color: var(--text-muted);
  }

  .article-body :global(a) {
    color: var(--text-color);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--accent-color);
    transition: color 150ms ease;
  }
  
  .article-body :global(a:hover) {
    color: var(--accent-color);
  }

  .article-footer {
    margin-top: 6rem;
    padding-top: 3rem;
  }

  .article-footer h3 {
    margin-bottom: 2rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }

  .related-card {
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--border-color);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease;
  }

  .related-card:hover {
    border-color: var(--accent-color);
    text-decoration: none;
  }

  .related-card:hover .related-title {
    color: var(--accent-color);
  }

  .related-date {
    margin-bottom: 0.75rem;
  }

  .related-title {
    font-size: 1.25rem;
    margin: 0;
    transition: color 200ms ease;
  }
  
  .case-study-card {
    background-color: var(--c-bone);
  }
  
  :root[data-theme='dark'] .case-study-card {
    background-color: var(--c-bone); /* Uses night bone */
  }

  @media (max-width: 768px) {
    .article-header {
      margin-bottom: 2.5rem;
    }

    .article-header h1 {
      font-size: 2rem;
    }

    .article-details {
      flex-direction: column;
      gap: 1rem;
    }

    .article-footer {
      margin-top: 4rem;
      padding-top: 2rem;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { track } from '../../lib/analytics';

  function setupReadingProgress() {
    const articleContent = document.getElementById('article-content');
    const progressBar = document.getElementById('reading-progress');

    if (!articleContent || !progressBar) return;

    let readFired = false;

    const updateProgress = () => {
      const rect = articleContent.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      // Calculate how much of the article we've scrolled past
      // Started reading: rect.top <= windowHeight
      // Finished reading: rect.bottom <= windowHeight
      
      const totalHeight = rect.height;
      const scrolled = windowHeight - rect.top;
      
      let progress = 0;
      if (scrolled > 0) {
        progress = (scrolled / totalHeight) * 100;
        // Clamp between 0 and 100
        progress = Math.max(0, Math.min(100, progress));
      }
      
      progressBar.style.width = `${progress}%`;

      if (progress >= 75 && !readFired) {
        readFired = true;
        track('article_read_75');
      }
    };
    
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    
    // Initial update
    updateProgress();
  }

  document.addEventListener('astro:page-load', setupReadingProgress);
</script>
